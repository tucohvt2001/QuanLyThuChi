{
  "name": "quanlythuchi-app",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue,green\" \"npm run backend:dev\" \"npm run frontend:dev\"",
    "backend": "npm --prefix backend start",
    "backend:dev": "npm --prefix backend run dev",
    "frontend:dev": "npm --prefix frontend run dev",
    "frontend:build": "npm --prefix frontend run build",
    "backend:install": "npm --prefix backend install",
    "frontend:install": "npm --prefix frontend install",
    "install:all": "npm run backend:install && npm run frontend:install",
    "db:migrate": "npm --prefix backend run migrate",
    "db:seed": "npm --prefix backend run seed"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
